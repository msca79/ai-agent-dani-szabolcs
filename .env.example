# LLM
ANTHROPIC_API_KEY=

# Embedding (src/rag) — text-embedding-3-small
OPENAI_API_KEY=

# Postgres (docker-compose)
POSTGRES_DB=boardgame
POSTGRES_USER=boardgame
POSTGRES_PASSWORD=boardgame
# Host port a docker-compose Postgres-hez; 5433 az alapértelmezett, mert az 5432-t
# más helyi projekt is használhatja.
POSTGRES_PORT=5433

# Agent belső tool-jai — read-only kapcsolat (csak SELECT, boardgame_ro role)
DATABASE_URL_READONLY=postgresql://boardgame_ro:boardgame_ro_dev_only@localhost:5433/boardgame

# Ingest-agent (upsertProduct tool) — írásra képes kapcsolat, de csak a games
# táblán, csak INSERT/UPDATE (boardgame_rw role, nincs DELETE/DDL joga)
DATABASE_URL_WRITE=postgresql://boardgame_rw:boardgame_rw_dev_only@localhost:5433/boardgame

# rag-loader script (src/rag/load-knowledge) — csak a knowledge táblán
# SELECT/INSERT/DELETE (boardgame_rag role, nincs hozzáférése a games-hez)
DATABASE_URL_RAG=postgresql://boardgame_rag:boardgame_rag_dev_only@localhost:5433/boardgame
